# ─────────────────────────────────────────────
#  Root .gitignore — EduInsight
# ─────────────────────────────────────────────

# Environment variable files — never commit secrets!
.env
.env.local
.env.*.local
.env.production

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.db
*.sqlite3
venv/
.venv/
*.egg-info/
dist/
build/

# Node
node_modules/
frontend/dist/
frontend/dist-ssr/

# IDE / OS
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
